# visnyk — example env
# Copy to .env and fill values. Never commit .env with real secrets.

# Telegram — get at https://my.telegram.org → API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Optional overrides
# TELEGRAM_SESSION_PATH=telegram-store/session.json
# WHATSAPP_DB_PATH=whatsapp-store/whatsapp.db
